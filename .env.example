# ==========================================
# KONFIGURASI BOT TELEGRAM
# ==========================================
# Ambil dari chat dengan @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Ambil ID akun Telegram kamu dari chat dengan @userinfobot
TELEGRAM_CHAT_ID=

# ==========================================
# KONFIGURASI COOKIE CLASSROOM ITATS
# ==========================================
# Ambil dari Browser: F12 -> Network -> Klik kanan request 'home' -> Copy as cURL
CLASSROOM_SESSION=
XSRF_TOKEN=
CF_CLEARANCE=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:157.0) Gecko/20100101 Firefox/157.0

# ==========================================
# PENGATURAN
# ==========================================
# Interval pengecekan dalam satuan menit (default: 15)
CHECK_INTERVAL_MINUTES=15
